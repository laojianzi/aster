+// LibraryPath uses packaged resources or the executable directory only. No
+// environment override, system lookup, cache search or runtime download.
+func LibraryPath()(string,error){
+ name,_,err:=librarySpec();if err!=nil{return "",err}
+ exe,err:=os.Executable();if err!=nil{return "",errors.New("executable directory unavailable")}
+ dirs:=[]string{filepath.Dir(exe)}
+ if d,e:=mygo.App.Path(mygo.PathResources);e==nil&&d!="" {dirs=append([]string{d},dirs...)}
+ for _,d:=range dirs {p:=filepath.Join(d,name);if _,e:=os.Lstat(p);e==nil{if e=ValidateLibrary(p);e!=nil{return "",e};return p,nil}}
+ return "",errors.New("terminal library not packaged; run the verified build preparation")
+}
+func Load()error{
+ load.mu.Lock();defer load.mu.Unlock()
+ if load.loaded{return load.err}
+ p,err:=LibraryPath();if err!=nil{return err};return loadFile(p)
+}
+// LoadFile is for explicit embedding/test callers, never derived from a
+// kubeconfig or remote output. Hash verification is always mandatory.
+func LoadFile(path string)error{
+ load.mu.Lock();defer load.mu.Unlock()
+ if !filepath.IsAbs(path){return errors.New("terminal library path must be absolute")}
+ if err:=ValidateLibrary(path);err!=nil{return err};if load.loaded{return load.err};return loadFile(path)
+}
+func loadFile(path string)error{load.path=path;load.loaded=true;load.err=vt.Load(path);return load.err}
