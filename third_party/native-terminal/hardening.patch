+type inputQueue struct {
+ mu sync.Mutex
+ cond *sync.Cond
+ queue [][]byte
+ bytes, chunks int
+ closed bool
+ failed chan struct{}
+ err error
+}
+func(q *inputQueue) init(){ if q.cond==nil { q.cond=sync.NewCond(&q.mu);q.failed=make(chan struct{}) } }
+func(q *inputQueue) failLocked(err error){
+ if q.err!=nil || q.closed { return }
+ q.err=err;q.closed=true;q.queue=nil;close(q.failed);q.cond.Broadcast()
+}
+func(q *inputQueue) fail(err error){q.mu.Lock();defer q.mu.Unlock();q.init();q.failLocked(err)}
+func(q *inputQueue) push(p []byte){
+ q.mu.Lock();defer q.mu.Unlock();q.init()
+ if q.closed || len(p)==0{return}
+ if len(p)>MaxInputChunk+16 || len(p)>MaxInputBytes-q.bytes || q.chunks>=MaxInputChunks { q.failLocked(ErrInputLimit);return }
+ q.queue=append(q.queue,append([]byte(nil),p...));q.bytes+=len(p);q.chunks++;q.cond.Signal()
+}
+func(q *inputQueue) close(){q.mu.Lock();defer q.mu.Unlock();q.init();q.closed=true;q.queue=nil;q.cond.Broadcast()}
+func(q *inputQueue) run(w io.Writer){
+ for {
+  q.mu.Lock();q.init()
+  for len(q.queue)==0&&!q.closed{q.cond.Wait()}
+  if q.closed{q.mu.Unlock();return}
+  p:=q.queue[0];q.queue[0]=nil;q.queue=q.queue[1:];q.mu.Unlock()
+  n,err:=w.Write(p)
+  q.mu.Lock();q.bytes-=len(p);q.chunks--
+  if err==nil&&n!=len(p){err=io.ErrShortWrite}
+  if err!=nil{q.failLocked(err)}
+  q.mu.Unlock()
+  if err!=nil{return}
+ }
+}
